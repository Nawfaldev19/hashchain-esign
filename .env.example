# Copy to .env to override defaults. Signoff Ledger needs no secrets to run.

# Port the HTTP server listens on.
PORT=4000

# Public base URL used when building signing links.
PUBLIC_URL=http://localhost:4000

# Where the embedded Postgres keeps its files. Use "memory" for a throwaway database.
DATA_DIR=.data/pglite

# Seed fictional demo data when the database is empty (true or false).
SEED_DEMO=true

# Hours until a sign-in session expires.
SESSION_TTL_HOURS=12

# Log level: debug, info, warn or error.
LOG_LEVEL=info
